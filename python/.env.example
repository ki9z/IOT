# TU DIEN URI that vao .env tren may ca nhan, KHONG tai len GitHub.
# Driver user/password lay trong Atlas Database Access.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>.mongodb.net/?appName=Cluster0
MONGO_DB=iot_lab2
MONGO_COLLECTION=iot_raw
MONGO_PROCESSED_COLLECTION=iot_processed
MONGO_WRITE_METRICS_COLLECTION=iot_write_metrics
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
# phai khop voi MQTT_TOPIC trong firmware/sketch.ino
MQTT_TOPIC=iot/lab2/lab2_7f26b9/esp32_01/telemetry
